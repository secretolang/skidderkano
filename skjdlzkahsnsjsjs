		if viewingSingle then
			setCameraToPlayer(player)
			viewingSingle = false
			viewBtn.Text = "View Player"
			updateInfoForSelected()
			return
		end

		if selectedPlayer and setCameraToPlayer(selectedPlayer) then
			viewingSingle = true
			viewBtn.Text = "Unview Player"
			info.Text = ("Viewing: %s"):format(selectedPlayer.Name)
		else
			info.Text = "Can't view (no character/humanoid)."
		end
	end)

	-- Teleport
	tpBtn.MouseButton1Click:Connect(function()
		if not selectedPlayer then return end
		local targetHRP = getHRP(selectedPlayer)
		local myChar = player.Character
		if myChar and targetHRP then
			myChar:MoveTo(targetHRP.Position + Vector3.new(0, 2, 0))
		end
	end)

	-- Bring
	bringBtn.MouseButton1Click:Connect(function()
		if not selectedPlayer then return end
		local myHRP = getHRP(player)
		local targetChar = selectedPlayer.Character
		if myHRP and targetChar then
			targetChar:MoveTo(myHRP.Position + Vector3.new(2, 0, 0))
		end
	end)

	-- Add friend
	addBtn.MouseButton1Click:Connect(function()
		if selectedPlayer then
			player:RequestFriendship(selectedPlayer)
		end
	end)

	-- View All
	viewAllBtn.MouseButton1Click:Connect(function()
		viewingAll = not viewingAll
		viewAllThreadId += 1
		local myThreadId = viewAllThreadId

		if viewingAll then
			viewingSingle = false
			viewBtn.Text = "View Player"

			viewAllBtn.Text = "View All: ON"
			viewAllBtn.BackgroundColor3 = COLORS.GREEN
			info.Text = "Viewing all players..."
			currentIndex = 0

			task.spawn(function()
				while viewingAll and viewAllThreadId == myThreadId do
					local all = Players:GetPlayers()
					if #all > 0 then
						currentIndex += 1
						if currentIndex > #all then currentIndex = 1 end
						local target = all[currentIndex]
						if target and setCameraToPlayer(target) then
							info.Text = ("Viewing: %s"):format(target.Name)
						end
					end
					task.wait(3)
				end
			end)
		else
			viewAllBtn.Text = "View All: OFF"
			viewAllBtn.BackgroundColor3 = COLORS.RED
			setCameraToPlayer(player)
			updateInfoForSelected()
		end
	end)

	-- Minimized button (restore)
	local minimizedFrame = Instance.new("TextButton")
	minimizedFrame.Name = "Minimized"
	minimizedFrame.Size = UDim2.new(0, 180, 0, 44)
	minimizedFrame.Position = UDim2.new(0.5, -90, 0.25, 0)
	minimizedFrame.BackgroundColor3 = COLORS.TOPBAR
	minimizedFrame.Text = "CrimsonB"
	minimizedFrame.Font = Enum.Font.GothamBold
	minimizedFrame.TextColor3 = Color3.new(1, 1, 1)
	minimizedFrame.TextSize = 18
	minimizedFrame.BorderSizePixel = 0
	minimizedFrame.Visible = false
	minimizedFrame.Parent = gui
	Instance.new("UICorner", minimizedFrame).CornerRadius = UDim.new(0, 12)

	local function toggleMinimize()
		minimized = not minimized

		if minimized then
			local t = TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 320, 0, 44),
				BackgroundTransparency = 1,
			})
			t:Play()
			t.Completed:Wait()
			frame.Visible = false
			minimizedFrame.Visible = true
		else
			minimizedFrame.Visible = false
			frame.Visible = true
			frame.Size = UDim2.new(0, 320, 0, 44)
			frame.BackgroundTransparency = 1
			TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 320, 0, 520),
				BackgroundTransparency = 0.05,
			}):Play()
		end
	end

	minimizeBtn.MouseButton1Click:Connect(toggleMinimize)
	minimizedFrame.MouseButton1Click:Connect(toggleMinimize)

	-- Close (destroys GUI + restores camera)
	local function closeGui()
		viewingAll = false
		viewAllThreadId += 1
		viewingSingle = false
		setCameraToPlayer(player)
		gui:Destroy()
	end

	closeBtn.MouseButton1Click:Connect(closeGui)

	-- Hotkey M
	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.M then
			toggleMinimize()
		end
	end)
end)

