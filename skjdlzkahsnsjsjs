local trackingEnabled = false
local beams = {}     -- [Player] = { beam=Beam, a0=Attachment, a1=Attachment }
local nameTags = {}  -- [Player] = BillboardGui
local trackConn

local function notify(titleText, bodyText)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = titleText,
			Text = bodyText,
			Duration = 3
		})
	end)
end

local function getMyRoot()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function cleanupPlayerVisuals(p)
	local b = beams[p]
	if b then
		if b.beam then b.beam:Destroy() end
		if b.a0 then b.a0:Destroy() end
		if b.a1 then b.a1:Destroy() end
		beams[p] = nil
	end

	local tag = nameTags[p]
	if tag then
		tag:Destroy()
		nameTags[p] = nil
	end
end

local function stopTracking()
	trackingEnabled = false

	if trackConn then
		trackConn:Disconnect()
		trackConn = nil
	end

	for p, _ in pairs(beams) do
		cleanupPlayerVisuals(p)
	end
	for p, _ in pairs(nameTags) do
		cleanupPlayerVisuals(p)
	end

	table.clear(beams)
	table.clear(nameTags)

	notify("Track All", "OFF")
end

local function ensureBeamAndTagFor(p, myRoot, targetRoot)
	-- Beam
	if not beams[p] then
		local a0 = Instance.new("Attachment")
		a0.Name = "VVTEC_MyAttach"
		a0.Parent = myRoot

		local a1 = Instance.new("Attachment")
		a1.Name = "VVTEC_TargetAttach"
		a1.Parent = targetRoot

		local beam = Instance.new("Beam")
		beam.Name = "VVTEC_TrackBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		beam.Width0 = 0.2
		beam.Width1 = 0.2
		beam.LightEmission = 1
		beam.FaceCamera = true
		beam.Parent = myRoot

		beams[p] = { beam = beam, a0 = a0, a1 = a1 }
	end

	-- NameTag
	if not nameTags[p] then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "VVTEC_NameTag"
		billboard.Size = UDim2.fromOffset(140, 28)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = targetRoot

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.fromScale(1, 1)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = p.DisplayName ~= "" and p.DisplayName or p.Name
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextStrokeTransparency = 0.5
		nameLabel.TextScaled = true
		nameLabel.Parent = billboard

		nameTags[p] = billboard
	end
end

local function startTracking()
	if trackingEnabled then return end
	trackingEnabled = true

	notify("Track All", "ON")

	-- Rebuild on respawn (local)
	player.CharacterAdded:Connect(function()
		if trackingEnabled then
			stopTracking()
			task.wait(0.1)
			startTracking()
		end
	end)

	-- Cleanup when a player leaves
	Players.PlayerRemoving:Connect(function(p)
		cleanupPlayerVisuals(p)
	end)

	trackConn = RunService.RenderStepped:Connect(function()
		if not trackingEnabled then return end

		local myRoot = getMyRoot()
		if not myRoot then return end

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				local targetRoot = char and char:FindFirstChild("HumanoidRootPart")

				if targetRoot then
					ensureBeamAndTagFor(p, myRoot, targetRoot)
				else
					cleanupPlayerVisuals(p)
				end
			end
		end
	end)
end

