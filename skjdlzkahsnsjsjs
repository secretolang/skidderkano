	tabButton.AutoButtonColor = true
	tabButton.Parent = tabBar

	local tabButtonCorner = Instance.new("UICorner")
	tabButtonCorner.CornerRadius = UDim.new(0, 6)
	tabButtonCorner.Parent = tabButton

	local page = Instance.new("ScrollingFrame")
	page.Name = tabName .. "_Page"
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 4
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.Parent = pages

	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 8)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = page

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 12)
	padding.Parent = page

	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 24)
	end)

	table.insert(allPages, page)
	table.insert(allTabButtons, tabButton)

	tabButton.MouseButton1Click:Connect(function()
		for _, p in ipairs(allPages) do
			p.Visible = false
		end

		for _, b in ipairs(allTabButtons) do
			b.BackgroundColor3 = RED_TAB
		end

		page.Visible = true
		tabButton.BackgroundColor3 = RED_ACTIVE
		currentPage = page
	end)

	if not currentPage then
		page.Visible = true
		tabButton.BackgroundColor3 = RED_ACTIVE
		currentPage = page
	end

	return page
end

local function createButton(parentPage, buttonName, callback)
	local btn = Instance.new("TextButton")
	btn.Name = buttonName:gsub("%s+", "") .. "_Button"
	btn.Size = UDim2.new(1, 0, 0, 36)
